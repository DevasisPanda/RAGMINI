# ==============================================================================
# RAGMINI / AssignRAG — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your API keys and configuration values below.
# 3. Never commit your actual .env file to public Git repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider — OpenRouter API
# ------------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Name (Free tier or paid model)
# Examples:
#   - poolside/laguna-s-2.1:free
#   - google/gemma-2-9b-it:free
#   - meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=poolside/laguna-s-2.1:free


# ------------------------------------------------------------------------------
# 2. Secondary LLM Provider — Google Gemini (Automatic Fallback)
# ------------------------------------------------------------------------------
# Automatically used when OpenRouter hits 429 rate limit or timeouts.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (from Google AI Studio)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Enable or disable automatic provider failover (true / false)
PROVIDER_FAILOVER=true


# ------------------------------------------------------------------------------
# 3. Vector Database — Qdrant Cloud
# ------------------------------------------------------------------------------
# Cluster URL from Qdrant Cloud Console: https://cloud.qdrant.io/
# Example: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.gcp.cloud.qdrant.io

# Qdrant Cloud API Key
QDRANT_API_KEY=your_qdrant_api_key_here

# Name of the vector collection
QDRANT_COLLECTION=pdf_documents


# ------------------------------------------------------------------------------
# 4. Embeddings & Chunking Configuration
# ------------------------------------------------------------------------------
# High-speed local ONNX embedding model via FastEmbed (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunk character size for text splitting
CHUNK_SIZE=500

# Overlap characters between chunks
CHUNK_OVERLAP=50

# Number of top relevant context chunks retrieved for LLM prompt
TOP_K=10


# ------------------------------------------------------------------------------
# 5. Web API Server & Security (server.py)
# ------------------------------------------------------------------------------
# Allowed CORS Origins (comma-separated domains or * for all)
# Production Example: https://devasispanda.com,https://yourportfolio.vercel.app
ALLOWED_ORIGINS=*

# Secret key required in 'X-Admin-Secret' header to trigger POST /api/index
ADMIN_SECRET_KEY=ragmini_admin_secret_2026

# Server Host & Port (defaults for local run)
HOST=0.0.0.0
PORT=8000


# ------------------------------------------------------------------------------
# 6. Debugging & Logging
# ------------------------------------------------------------------------------
# Enable verbose debug logs (true / false)
DEBUG_MODE=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
